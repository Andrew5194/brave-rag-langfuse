# Copy to .env and fill in. Load before launching Jupyter:
#   set -a; source .env; set +a

# --- Required ---
BRAVE_API_KEY=
ANTHROPIC_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Optional (defaults shown) ---
LANGFUSE_HOST=https://cloud.langfuse.com
ANSWER_MODEL=claude-opus-4-5
JUDGE_MODEL=claude-opus-4-5
